{
  // The root tsconfig only includes `src`/`scripts` and limits global types to `jest`, so the editor
  // has no Node or Playwright types for the e2e specs (e.g. `Buffer`, the Playwright test globals).
  // This config covers the e2e folder with the right types. Playwright transpiles specs at runtime
  // without type-checking, so this is purely for editor/IDE type-checking.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "@playwright/test"]
  },
  "include": ["**/*.ts", "global.d.ts"]
}
